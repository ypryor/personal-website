---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = profile.statement } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}`;
const here = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { label: 'Research', path: '/research/' },
  { label: 'Publications', path: '/publications/' },
  { label: 'CV + Talks', path: '/cv/' },
];
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name}, ${profile.suffix}`;
const links = Object.entries(profile.links).filter(([, url]) => url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href('/')}>
          <img src={href('/logo.svg')} alt="" width="36" height="36" />
          <b>Yemko Pryor, PhD<span>.</span></b>
        </a>
        <nav class="nav" aria-label="Main">
          {
            nav.map((n) => (
              <a href={href(n.path)} aria-current={here === href(n.path).replace(/\/$/, '') ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <h2>Let’s talk.</h2>
        <div class="foot-grid">
          <div>
            {profile.role}, {profile.lab}<br />
            {profile.institution} · {profile.location}
            {
              profile.email && (
                <>
                  <br />
                  <a href={`mailto:${profile.email}`}>{profile.email}</a>
                </>
              )
            }
          </div>
          {
            links.length > 0 && (
              <ul class="foot-links">
                {links.map(([label, url]) => (
                  <li>
                    <a href={url} rel="me noopener">
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        <p class="fine">© {new Date().getFullYear()} {profile.name}</p>
      </div>
    </footer>
  </body>
</html>
