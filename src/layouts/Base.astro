---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = profile.statement } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}`;
const here = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { label: 'Research', path: '/research/' },
  { label: 'Publications', path: '/publications/' },
  { label: 'Media', path: '/media/' },
  { label: 'Outreach + Mentorship', path: '/outreach/' },
  { label: 'CV + Talks', path: '/cv/' },
];
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name}, ${profile.suffix}`;
const links = Object.entries(profile.links).filter(([, url]) => url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href={href('/favicon.png')} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href('/')}>
          <img src={href('/logo-cream.png')} alt="" width="39" height="44" />
          <b>Yemko Pryor, PhD<span>.</span></b>
        </a>
        <nav class="nav" aria-label="Main">
          {
            nav.map((n) => (
              <a href={href(n.path)} aria-current={here === href(n.path).replace(/\/$/, '') ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="blocks">
      <slot />
    </main>

    <footer class="cb-footer">
      <section id="contact" class="cb-contact">
        <div class="cb-talk">
          <h2>Let’s<br />Chat.</h2>
          <p class="cb-note">{profile.contactNote}</p>
          <div class="where">
            <p class="loc">{profile.location.replace(', MI', ', Michigan')}</p>
            {
              links.length > 0 && (
                <ul>
                  {links.map(([label, url]) => (
                    <li>
                      <a href={url} rel="me noopener">
                        {label}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </div>

        <form
          class="cb-form"
          id="contact-form"
          method="post"
          action={profile.contactEndpoint || undefined}
          data-mailto={profile.contactEndpoint ? undefined : profile.email}
        >
          <div class="f">
            <label for="cf-first">First name</label>
            <input id="cf-first" name="first_name" type="text" autocomplete="given-name" required />
          </div>
          <div class="f">
            <label for="cf-last">Last name</label>
            <input id="cf-last" name="last_name" type="text" autocomplete="family-name" required />
          </div>
          <div class="f full">
            <label for="cf-email">Email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="f full">
            <label for="cf-org">Institution or organization (optional)</label>
            <input id="cf-org" name="organization" type="text" autocomplete="organization" />
          </div>
          <div class="f full">
            <label for="cf-message">Message</label>
            <textarea id="cf-message" name="message" rows="5" required></textarea>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="cf-site">Leave this field empty</label>
            <input id="cf-site" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="full">
            <button type="submit">Send message</button>
          </div>
          <div class="send-options full" id="send-options" hidden>
            <p>Choose how to send your message:</p>
            <div class="send-row">
              <a class="send-opt" data-via="gmail" target="_blank" rel="noopener">Gmail</a>
              <a class="send-opt" data-via="outlook" target="_blank" rel="noopener">Outlook</a>
              <a class="send-opt" data-via="app">My email app</a>
              <button class="send-opt" type="button" data-via="copy">Copy message</button>
            </div>
          </div>
          <p class="status full" role="status" aria-live="polite"></p>
        </form>
      </section>
      <p class="cb-fine">© {new Date().getFullYear()} {profile.name}</p>
    </footer>

    <script is:inline>
      (function () {
        var form = document.getElementById('contact-form');
        if (!form) return;
        var status = form.querySelector('.status');
        form.addEventListener('submit', function (e) {
          var data = new FormData(form);
          if (data.get('_gotcha')) {
            e.preventDefault();
            return;
          }
          var to = form.getAttribute('data-mailto');
          if (to) {
            // No form service configured: let the visitor pick how to send.
            e.preventDefault();
            var name = (data.get('first_name') + ' ' + data.get('last_name')).trim();
            var org = data.get('organization');
            var subject = 'Website message from ' + name;
            var body = data.get('message') + '\n\n' + name + (org ? '\n' + org : '') + '\n' + data.get('email');
            var q = encodeURIComponent;
            var urls = {
              gmail: 'https://mail.google.com/mail/?view=cm&fs=1&to=' + q(to) + '&su=' + q(subject) + '&body=' + q(body),
              outlook: 'https://outlook.office.com/mail/deeplink/compose?to=' + q(to) + '&subject=' + q(subject) + '&body=' + q(body),
              app: 'mailto:' + to + '?subject=' + q(subject) + '&body=' + q(body),
            };
            var box = document.getElementById('send-options');
            box.querySelectorAll('a.send-opt').forEach(function (a) {
              a.href = urls[a.getAttribute('data-via')];
            });
            var copy = box.querySelector('[data-via="copy"]');
            copy.onclick = function () {
              var text = 'To: ' + to + '\nSubject: ' + subject + '\n\n' + body;
              navigator.clipboard.writeText(text).then(
                function () {
                  status.textContent = 'Copied. Paste it into any email to ' + to + '.';
                },
                function () {
                  status.textContent = 'Could not copy. Please email ' + to + ' directly.';
                }
              );
            };
            box.hidden = false;
            status.textContent = '';
            box.querySelector('a.send-opt').focus();
            return;
          }
          // Form service configured: send without leaving the page.
          e.preventDefault();
          status.textContent = 'Sending…';
          fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } })
            .then(function (r) {
              if (!r.ok) throw new Error('send failed');
              form.reset();
              status.textContent = 'Thank you. Your message was sent.';
            })
            .catch(function () {
              status.textContent = 'Sorry, the message could not be sent. Please try again later.';
            });
        });
      })();
    </script>
  </body>
</html>
