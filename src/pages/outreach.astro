---
import Base from '../layouts/Base.astro';
import { outreach, mentorship } from '../data/site';
const groups = [
  { title: 'Community', items: outreach },
  { title: 'Mentorship', items: mentorship },
];
---

<Base title="Outreach + Mentorship" description="Community engagement and mentorship by Yemko Pryor, PhD.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow"><b>●</b> Community engagement and training</p>
      <h1 class="page-title">Outreach +<br />Mentorship</h1>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="section">
        <div class="wrap">
          <h2 class="out-head">{g.title}</h2>
      <ol class="path">
        {
          g.items.map((o) => (
            <li>
              <div>
                <h3>{o.org}</h3>
                <div class="what">{o.role}</div>
                {o.when && <div class="what">{o.when}</div>}
              </div>
              <div>
                <p>{o.body}</p>
                {o.links.length > 0 && (
                  <ul class="chips" style="margin-top:14px">
                    {o.links.map((l) => (
                      <li>
                        <a href={l.href} rel="noopener">
                          {l.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
        </div>
      </section>
    ))
  }
</Base>
