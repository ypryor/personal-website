---
import Base from '../layouts/Base.astro';
import PubList from '../components/PubList.astro';
import { profile, scales, publications, methods } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const band = [
  'Human variation',
  'Admixture',
  'Population genomics',
  'Historical genomics',
  'African Diaspora',
  'Epigenomics',
  'Pigmentation',
];
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">
        <b>●</b> {profile.role} · {profile.lab} · {profile.institution}
      </p>
      <h1>Yemko<br /><em>Pryor</em></h1>

      <div class="hero-grid">
        <p class="tagline">DNA is a <mark>historical document.</mark> I read it alongside the archive to trace how history shapes human variation.</p>
        <div>
          <p class="lede">{profile.statement}</p>
          <div class="btns">
            <a class="btn" href={`${base}/research/`}>Research program</a>
            <a class="btn ghost" href={`${base}/publications/`}>Publications</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="band" aria-hidden="true">
    <div class="band-track">
      {[...band, ...band, ...band, ...band].map((b) => <span>{b}</span>)}
    </div>
  </div>

  <section class="section dark">
    <div class="wrap">
      <div class="section-head">
        <h2>One question,<br />three scales</h2>
        <a href={`${base}/research/`}>Full research program →</a>
      </div>
      <div class="scales">
        {
          scales.map((s) => (
            <article class="scale">
              <div class="num">{s.n}</div>
              <div class="kicker">{s.kicker}</div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Recent work</h2>
        <a href={`${base}/publications/`}>All publications →</a>
      </div>
      <PubList items={publications.slice(0, 2)} />
    </div>
  </section>

  <section class="section tint">
    <div class="wrap two">
      <h2>Toolkit</h2>
      <ul class="chips">
        {methods.map((m) => <li class="plain">{m}</li>)}
      </ul>
    </div>
  </section>
</Base>
