---
import Base from '../layouts/Base.astro';
import { profile, scales, centralGoal, publications, connections } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latest = publications[0];
const latestJournal = latest.venue.replace(/\s\d.*$/, '');
const tones = ['is-magenta', 'is-red', ''];
---

<Base>
  <div class="cb-hero">
    <section class="cb-name">
      <div class="cb-kicker">Genetic Historian</div>
      <h1>Yemko<br />Pryor</h1>
      <p>{profile.intro}</p>
    </section>
    <figure class="cb-photo" style="margin:0">
      <img
        src={`${base}/headshot.jpg`}
        alt="Portrait of Yemko Pryor, smiling, with short purple hair, round glasses and DNA double-helix earrings"
        width="800"
        height="1000"
      />
      <figcaption>
        {profile.role} · <a href={profile.labUrl} rel="noopener">{profile.lab}</a> ·<br />{profile.institution}
      </figcaption>
    </figure>
  </div>

  <section class="cb-goal">
    <h2>One goal</h2>
    <p>{centralGoal}</p>
  </section>

  <div class="cb-three">
    {
      scales.map((s, i) => (
        <a class={`cb-q ${tones[i] ?? ''}`} href={`${base}/research/#${s.id}`}>
          <div class="n">{s.n}</div>
          <div class="k">{s.short.label}</div>
          <h3>{s.short.question}</h3>
        </a>
      ))
    }
  </div>

  <div class="cb-more">
    <a class="cb-tile is-wide" href={`${base}/publications/`}>
      <div class="top">
        <span>Latest publication · {latest.year}</span>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square"><path d="M6 18L18 6M8 6h10v10"></path></svg>
      </div>
      <div>
        <h3>{latestJournal}</h3>
        <p>All publications</p>
      </div>
    </a>
    <a class="cb-tile is-orange" href={`${base}/media/`}>
      <div class="top">
        <span>Media</span>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square"><path d="M6 18L18 6M8 6h10v10"></path></svg>
      </div>
      <h3>Press, profiles and interviews</h3>
    </a>
    <a class="cb-tile" href={`${base}/outreach/`}>
      <div class="top">
        <span>Outreach + CV</span>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square"><path d="M6 18L18 6M8 6h10v10"></path></svg>
      </div>
      <h3>Community work, mentorship, talks and teaching</h3>
    </a>
  </div>

  <div class="cb-three">
    {
      connections.map((c) => (
        <section class="cb-conn">
          <h2>{c.title}</h2>
          <ul>
            {c.items.map((it) => (
              <li>
                <b>{it.name}</b>
                {it.detail}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
